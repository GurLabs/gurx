# GurX™ Design Awards — ortam değişkenleri
# Bu dosyayı `.env` olarak kopyalayın ve değerleri Supabase projenizden alın:
# Supabase Dashboard → Project Settings → API

VITE_SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...

# Kanonik adres (SEO etiketleri ve sertifika doğrulama bağlantıları için)
VITE_SITE_URL=https://gurx.gurlabs.com

# Cloudflare Turnstile (bot koruması) — Cloudflare Dashboard → Turnstile → Site ekle
# Boş bırakılırsa kayıt ve doğrulama sayfalarında bu adım atlanır.
VITE_TURNSTILE_SITE_KEY=0x4AAAAAAA...
